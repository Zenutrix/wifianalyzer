#include <winver.h>

/* Versionsnummer und absolute Pfade setzt build.rs beim Bauen ein */
1 ICON "assets/icon.ico"
/* MinGW bringt ein eigenes Standard-Manifest mit; unseres nur beim MSVC-Build (offizielle Releases) */
#ifdef APP_MANIFEST
1 24 "assets/app.manifest"
#endif

VS_VERSION_INFO VERSIONINFO
FILEVERSION APP_FILEVERSION
PRODUCTVERSION APP_FILEVERSION
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_APP
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904B0"
    BEGIN
      VALUE "CompanyName", "Thomas Schoepf"
      VALUE "FileDescription", "WiFi Analyzer"
      VALUE "ProductName", "WiFi Analyzer"
      VALUE "FileVersion", APP_VERSION
      VALUE "ProductVersion", APP_VERSION
      VALUE "LegalCopyright", "(c) 2026 Thomas Schoepf - GPL-3.0-or-later"
      VALUE "Comments", "https://schoepf-tirol.at/Project/WifiAnalyzer"
      VALUE "OriginalFilename", "WiFiAnalyzer.exe"
      VALUE "InternalName", "wifi-analyzer"
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x0409, 1200
  END
END
